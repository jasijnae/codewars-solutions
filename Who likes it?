const likes = names => names.length === 0 || names.length === undefined ? 'no one likes this' : names.length === 1 ? `${names[0]} likes this` : names.length === 2 ? `${names.slice(0, 1)} and ${names.slice(1, 2)} like this` :  names.length > 3 ? `${names[0]}, ${names[1]} and ${names.length - 2} others like this` : `${names[0]}, ${names[1]} and ${names[2]} like this`  
